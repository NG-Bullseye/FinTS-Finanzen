# FinTS-Finanzen — Umgebung. Kopiere nach .env (NICHT eingecheckt) und fuelle aus.

# AES-256-GCM Master-Key, base64-kodierte 32 Byte.
# Generieren via `python enroll.py` (Option Key generieren) oder:
#   python -c "import crypto; print(crypto.generate_key())"
# OHNE diesen Key sind die gespeicherten Credentials unlesbar.
FINTS_MASTER_KEY=

# Optional: eigene registrierte FinTS product_id.
# Leer lassen -> Default aus config.py (oeffentliche, DKB-akzeptierte ID, #183).
# DKB lehnt UNGUELTIGE product_ids vor jeder TAN-Abfrage ab (9210/9800/9050).
# Eigene ID registrieren: https://www.fints.org/de/hersteller/produktregistrierung
FINTS_PRODUCT_ID=
