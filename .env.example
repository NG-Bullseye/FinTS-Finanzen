# FinTS-Finanzen — Umgebung. Kopiere nach .env (NICHT eingecheckt) und fuelle aus.

# AES-256-GCM Master-Key, base64-kodierte 32 Byte.
# Generieren via `python enroll.py` (Option Key generieren) oder:
#   python -c "import crypto; print(crypto.generate_key())"
# OHNE diesen Key sind die gespeicherten Credentials unlesbar.
FINTS_MASTER_KEY=

# Optional: registrierte FinTS product_id (DKB verlangt sie evtl.).
# Leer lassen -> python-fints Lib-Default wird genutzt. NICHT selbst registrieren.
FINTS_PRODUCT_ID=
